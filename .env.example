# Copy to .env and fill in real values. Never commit .env.
# nibba-Shop.bat creates this automatically on first launch (shop PCs).
# This file is for developers running from this folder only.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Secret Django-admin path (owner only). Default serves /admin/ for local
# dev; on a shop PC set a random value so /admin/ 404s for strangers.
# Example: DJANGO_ADMIN_PATH=manage-vh-9x3k/
DJANGO_ADMIN_PATH=admin/

# Optional: in-app update checks (Help page pings GitHub Releases, ~2s).
# Blank = updates off. Only needed on the shop PC, never in dev.
# UPDATE_REPO=owner/repo
# UPDATE_TOKEN=  (only for private repos; read-only token, never commit)

# PC-only: the app listens on 127.0.0.1 and ALLOWED_HOSTS stays
# localhost. Never add LAN IPs or tunnel hosts here — no other
# device connects to this app, by design.
